# ─────────────────────────────────────────────────────────────
# Architecto — configuration (tout est piloté par l'environnement)
# Copier en .env et renseigner les secrets. Rien n'est en dur côté code.
# ─────────────────────────────────────────────────────────────

# App (préfixe APP_)
APP_NAME=Architecto
APP_ENV=dev            # dev | staging | prod
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (préfixe DB_) — l'URL est composée à partir de ces champs
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5433
DB_USER=architecto
DB_PASSWORD=architecto
DB_NAME=architecto
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# LLM (préfixe LLM_)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
# LLM_MAX_TOKENS=

# LangSmith / observabilité (préfixe LANGSMITH_)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=architecto
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# CORS (préfixe CORS_) — origines séparées par des virgules
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Optionnel : forcer un autre fichier d'env
# ENV_FILE=/chemin/vers/.env
