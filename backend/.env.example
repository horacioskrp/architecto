# ─────────────────────────────────────────────────────────────
# Architecto — configuration (tout est piloté par l'environnement)
# Copier en .env et renseigner les secrets. Rien n'est en dur côté code.
# ─────────────────────────────────────────────────────────────

# App (préfixe APP_)
APP_NAME=Architecto
APP_ENV=dev            # dev | staging | prod
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# Agent (préfixe AGENT_)
# checkpointer : persistance des threads LangGraph
#   memory   = en mémoire (dev/tests, perdu au redémarrage)
#   postgres = durable via AsyncPostgresSaver (recommandé en prod)
AGENT_CHECKPOINTER=memory

# Database (préfixe DB_) — l'URL est composée à partir de ces champs
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5433
DB_USER=architecto
DB_PASSWORD=architecto
DB_NAME=architecto
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# Chat LLM (préfixe LLM_) — provider interchangeable via l'adaptateur
LLM_PROVIDER=anthropic          # anthropic | openai | google | deepseek
LLM_MODEL=claude-sonnet-5       # ex : gpt-4o-mini | gemini-2.5-flash | deepseek-chat
LLM_API_KEY=sk-ant-...          # clé du provider sélectionné
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
# LLM_MAX_TOKENS=
# LLM_BASE_URL=                 # pour DeepSeek / proxies OpenAI-compatibles

# Embeddings (préfixe EMBEDDING_) — découplé du chat (ni Anthropic ni DeepSeek n'en font)
EMBEDDING_PROVIDER=openai       # openai | google | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=
# --- Option "local" (fastembed, sans clé) : idéal avec DeepSeek en chat ---
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # id fastembed ; défaut si non fourni

# LangSmith / observabilité (préfixe LANGSMITH_)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=architecto
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# CORS (préfixe CORS_) — origines séparées par des virgules
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Optionnel : forcer un autre fichier d'env
# ENV_FILE=/chemin/vers/.env
