            "items": {
              "$ref": "#/components/schemas/ProjectOut"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "ProjectsList",
        "type": "object"
      },
      "SourceOut": {
        "description": "Une source ingérée dans la base de connaissances.",
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "source",
          "title",
          "chunk_count"
        ],
        "title": "SourceOut",
        "type": "object"
