{
  "components": {
    "schemas": {
      "Body_ingest_api_v1_knowledge_ingest_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_ingest_api_v1_knowledge_ingest_post",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "description": "Message de l'utilisateur",
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "project": {
            "default": "",
            "description": "Slug du projet (scope la mémoire long terme)",
            "title": "Project",
            "type": "string"
          },
          "thread_id": {
            "default": "default",
            "description": "Identifiant de conversation (mémoire)",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "answer"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "DecisionOut": {
        "properties": {
          "consequences": {
            "title": "Consequences",
            "type": "string"
          },
          "context": {
            "title": "Context",
            "type": "string"
          },
          "decision": {
            "title": "Decision",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "context",
          "decision",
          "consequences"
        ],
        "title": "DecisionOut",
        "type": "object"
      },
      "DecisionsList": {
        "properties": {
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionOut"
            },
            "title": "Decisions",
            "type": "array"
          }
        },
        "required": [
          "decisions"
        ],
        "title": "DecisionsList",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestResult": {
        "description": "Bilan d'une ingestion depuis le client.",
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "processed": {
            "title": "Processed",
            "type": "integer"
          },
          "rejected": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Rejected",
            "type": "array"
          },
          "skipped_empty": {
            "title": "Skipped Empty",
            "type": "integer"
          },
          "skipped_unchanged": {
            "title": "Skipped Unchanged",
            "type": "integer"
          }
        },
        "required": [
          "processed",
          "skipped_unchanged",
          "skipped_empty",
          "chunks"
        ],
        "title": "IngestResult",
        "type": "object"
      },
      "ProjectOut": {
        "properties": {
          "decision_count": {
            "title": "Decision Count",
            "type": "integer"
          },
          "name": {
            "title": "Name",
